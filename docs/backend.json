
{
  "entities": {
    "Subscription": {
      "title": "Subscription",
      "type": "object",
      "description": "Represents a user's active subscription plan and its validity.",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["userId", "amount", "startTime", "endTime", "isActive"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/userProfiles/{userId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "User profile data."
        }
      },
      {
        "path": "/subscriptions/{userId}",
        "definition": {
          "schema": { "$ref": "#/backend/entities/Subscription" },
          "description": "User subscription details. Document ID is the user UID."
        }
      }
    ]
  }
}
